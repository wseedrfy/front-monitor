    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "koa": "^2.16.0",
    "koa-bodyparser": "^4.4.1",
    "mysql2": "^3.9.1"
  },

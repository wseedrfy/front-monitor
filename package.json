{
  "name": "monitor-sdk-project",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:sdk": "pnpm --filter @monitor/browser dev",
    "dev:test": "pnpm --filter monitor-test dev",
    "dev:server": "ts-node backend/server.ts",
    "dev": "concurrently \"pnpm dev:sdk\" \"pnpm dev:server\" \"pnpm dev:test\"",
    "build": "pnpm --filter @monitor/browser build",
    "start": "ts-node backend/server.ts",
    "start:dev": "ts-node-dev --respawn backend/server.ts"
  },
